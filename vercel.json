{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "npm install",
  "functions": {
    "api/ai-quiz.ts": {
      "includeFiles": "api/_lib/**",
      "maxDuration": 30
    },
    "api/user-data.ts": {
      "includeFiles": "api/_lib/**",
      "maxDuration": 20
    },
    "api/clerk-webhook.ts": {
      "includeFiles": "api/_lib/**",
      "maxDuration": 15
    },
    "api/admin-ai.ts": {
      "includeFiles": "api/_lib/**",
      "maxDuration": 20
    },
    "api/community-helpful.ts": {
      "includeFiles": "api/_lib/**",
      "maxDuration": 10
    },
    "api/clerk-fapi.ts": {
      "includeFiles": "api/_lib/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/__clerk/(.*)",
      "destination": "/api/clerk-fapi?clerkPath=$1"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
