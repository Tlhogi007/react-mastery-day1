# Community contribute button
VITE_CONTENT_REPO_URL=https://github.com/Tlhogi007/react-mastery-content

# Optional: override content sync source for builds
# CONTENT_REPO_URL=https://github.com/Tlhogi007/react-mastery-content.git

# Google Analytics (optional)
# VITE_GA_TRACKING_ID=

# Sentry error monitoring (optional — free Developer plan)
# Create a browser project at https://sentry.io → copy the DSN
# VITE_SENTRY_DSN=https://xxxx@oXXXX.ingest.sentry.io/XXXX

# Source maps upload during `vite build` (CI / Vercel)
# Org auth token with org:ci — never commit real values
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=react-mastery-day-1
# SENTRY_PROJECT=react-mastery-day1

# AI quiz providers — SERVER ONLY (never prefix with VITE_)
# Waterfall: Groq → Gemini → Together
# GROQ_API_KEY=
# GEMINI_API_KEY=
# TOGETHER_API_KEY=

# Optional AI usage caps (server). Defaults: 5/min, 40/day/IP, max 5 questions/request
# AI_QUIZ_MAX_PER_MINUTE=5
# AI_QUIZ_MAX_PER_DAY=40
# AI_QUIZ_MAX_COUNT=5
# App-wide daily budget (all users sharing host keys). Default 200.
# AI_QUIZ_GLOBAL_MAX_PER_DAY=200

# Durable quota store (Upstash Redis REST) — required for signed-in per-user free tier.
# Without these, authenticated hosted AI returns 503 (fail closed) instead of bypassing caps.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Learners can also paste their own keys in Settings (localStorage BYO — not these envs).

# Clerk auth (hosted AI requires sign-in when CLERK_SECRET_KEY is set)
# Create an app at https://dashboard.clerk.com → API Keys
# Free hosted AI also requires a verified email (or Google/GitHub OAuth).
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# Origins allowed in JWT azp (comma-separated). Production: set to your canonical URL.
# APP_ORIGIN=https://react-mastery-day1.vercel.app
# CLERK_AUTHORIZED_PARTIES=https://react-mastery-day1.vercel.app
# Free hosted AI generations per signed-in user per day (default 5)
# AI_QUIZ_FREE_PER_USER_DAY=5

# Clerk webhooks (Dashboard → Webhooks → endpoint URL /api/clerk-webhook)
# Subscribe to: user.deleted, user.merged
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Admin AI panel (/api/admin-ai). Comma-separated Clerk user ids, or set publicMetadata.role=admin
# ADMIN_USER_IDS=user_xxx
