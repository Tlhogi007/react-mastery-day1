{
  "name": "react-mastery-day1",
  "private": true,
  "version": "1.5.17",
  "type": "module",
  "author": "Letlhogonolo Sekwati <lsekwati97@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tlhogi007/react-mastery-day1.git"
  },
  "scripts": {
    "dev": "vite",
    "sync:content": "node scripts/sync-content.cjs",
    "generate:content": "node scripts/generate-content-loader.cjs",
    "prepare:content": "npm run sync:content && npm run generate:content",
    "build": "npm run prepare:content && tsc && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "security": "node scripts/security-check.mjs",
    "security:audit": "SECURITY_AUDIT=1 node scripts/security-check.mjs",
    "sentry:autofix": "node scripts/setup-sentry-autofix.mjs --open",
    "sentry:autofix:check": "node scripts/setup-sentry-autofix.mjs",
    "release": "semantic-release",
    "stress": "node scripts/stress-test.mjs",
    "stress:http": "node scripts/stress-http.mjs",
    "check:commit": "node scripts/check-conventional-commit.mjs",
    "check:commits": "node scripts/check-conventional-commit.mjs --range origin/main..HEAD",
    "prepare": "husky"
  },
  "dependencies": {
    "@clerk/backend": "^3.30.0",
    "@clerk/react": "^6.18.9",
    "@clerk/ui": "^1.43.1",
    "@sentry/react": "^10.78.0",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^11.18.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-ga4": "^2.1.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@sentry/vite-plugin": "^5.4.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^31.0.2",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "playwright": "^1.58.2",
    "semantic-release": "^24.2.9",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
